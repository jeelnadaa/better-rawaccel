{
  "modes": [
    { "id": "off", "label": "Off", "accel": "noaccel", "note": "no acceleration; the sensitivity multiplier still applies", "params": [] },
    { "id": "linear", "label": "Linear", "accel": "classic", "fixed": { "exponentClassic": 2 }, "note": "sens = 1 + accel·(v − offset), held at cap",
      "params": ["acceleration", "inputOffset", "capMode", "capX", "capY", "gain"] },
    { "id": "classic", "label": "Classic", "accel": "classic", "note": "sens = 1 + (accel·(v − offset))^(exp−1), held at cap",
      "params": ["acceleration", "exponentClassic", "inputOffset", "capMode", "capX", "capY", "gain"] },
    { "id": "natural", "label": "Natural", "accel": "natural", "note": "rises past offset, eases toward limit",
      "params": ["decayRate", "limit", "inputOffset", "gain"] },
    { "id": "power", "label": "Power", "accel": "power", "note": "sens = (scale·v)^exp, held at cap",
      "params": ["scale", "exponentPower", "outputOffset", "capMode", "capX", "capY", "gain"] },
    { "id": "synchronous", "label": "Synchronous", "short": "Sync.", "accel": "synchronous", "note": "log-symmetric about sync speed",
      "params": ["syncSpeed", "motivity", "gamma", "smooth", "gain"] },
    { "id": "jump", "label": "Jump", "accel": "jump", "note": "smoothed step to output at input speed",
      "params": ["jumpInput", "jumpOutput", "smooth", "gain"] },
    { "id": "lut", "label": "Table", "short": "LUT", "accel": "lut", "note": "your own points, interpolated", "params": ["lut", "lutKind"] }
  ],
  "args": {
    "acceleration":    { "label": "Accel", "field": "acceleration", "min": 0, "max": 0.1, "step": 0.0005, "def": 0.005, "hmin": 0.000001, "hmax": 1000, "when": { "capMode": ["output", "input"] } },
    "exponentClassic": { "label": "Exponent", "field": "exponentClassic", "min": 1.05, "max": 5, "step": 0.05, "def": 2, "hmin": 1.0001, "hmax": 100 },
    "inputOffset":     { "label": "Offset", "unit": "c/ms", "field": "inputOffset", "min": 0, "max": 40, "step": 0.5, "def": 0, "hmin": 0, "hmax": 10000 },
    "outputOffset":    { "label": "Output offset", "unit": "×", "field": "outputOffset", "min": 0, "max": 3, "step": 0.05, "def": 0, "hmin": 0, "hmax": 1000 },
    "capMode":         { "label": "Cap by", "type": "choice", "field": "capMode", "options": [["output", "Output"], ["input", "Input"], ["in_out", "Both"]], "def": "output" },
    "capX":            { "label": "Cap input", "unit": "c/ms", "field": "capX", "min": 0, "max": 100, "step": 0.5, "def": 15, "hmin": 0, "hmax": 100000, "when": { "capMode": ["input", "in_out"] } },
    "capY":            { "label": "Cap output", "unit": "×", "field": "capY", "min": 0, "max": 10, "step": 0.05, "def": 1.5, "hmin": 0, "hmax": 1000, "when": { "capMode": ["output", "in_out"] }, "hint": "0 = no cap" },
    "decayRate":       { "label": "Decay", "field": "decayRate", "min": 0.005, "max": 0.5, "step": 0.005, "def": 0.1, "hmin": 0.000001, "hmax": 1000 },
    "limit":           { "label": "Limit", "unit": "×", "field": "limit", "min": 0.1, "max": 5, "step": 0.05, "def": 1.5, "hmin": 0.0001, "hmax": 1000 },
    "scale":           { "label": "Scale", "field": "scale", "min": 0.05, "max": 5, "step": 0.01, "def": 1, "hmin": 0.000001, "hmax": 1000 },
    "exponentPower":   { "label": "Exponent", "field": "exponentPower", "min": 0.01, "max": 1, "step": 0.01, "def": 0.05, "hmin": 0.0001, "hmax": 100 },
    "syncSpeed":       { "label": "Sync speed", "unit": "c/ms", "field": "syncSpeed", "min": 0.5, "max": 60, "step": 0.5, "def": 5, "hmin": 0.0001, "hmax": 100000 },
    "motivity":        { "label": "Motivity", "unit": "×", "field": "motivity", "min": 1.05, "max": 5, "step": 0.05, "def": 1.5, "hmin": 1.0001, "hmax": 1000 },
    "gamma":           { "label": "Gamma", "field": "gamma", "min": 0.1, "max": 5, "step": 0.05, "def": 1, "hmin": 0.0001, "hmax": 1000 },
    "smooth":          { "label": "Smooth", "field": "smooth", "min": 0, "max": 1, "step": 0.01, "def": 0.5, "hmin": 0, "hmax": 1 },
    "jumpInput":       { "label": "Input", "unit": "c/ms", "field": "capX", "min": 0.5, "max": 100, "step": 0.5, "def": 15, "hmin": 0.0001, "hmax": 100000 },
    "jumpOutput":      { "label": "Output", "unit": "×", "field": "capY", "min": 0.1, "max": 10, "step": 0.05, "def": 1.5, "hmin": 0.0001, "hmax": 1000 },
    "lutKind":         { "label": "Values", "type": "choice", "field": "gain", "options": [[false, "Sensitivity"], [true, "Output speed"]], "def": false },
    "gain":            { "label": "Applies to", "type": "choice", "field": "gain", "options": [[true, "Gain"], [false, "Velocity"]], "def": true },
    "lut":             { "label": "Points", "type": "lut", "field": "lut" }
  },
  "output": [
    { "label": "Sensitivity", "unit": "×", "field": "sens", "min": 0.05, "max": 5, "step": 0.01, "def": 1, "hmin": 0.001, "hmax": 1000 },
    { "label": "Y/X ratio", "field": "yxRatio", "min": 0.1, "max": 3, "step": 0.01, "def": 1, "hmin": 0.001, "hmax": 1000 },
    { "label": "Rotation", "unit": "deg", "field": "rotation", "min": -180, "max": 180, "step": 1, "def": 0, "hmin": -360, "hmax": 360 }
  ],
  "advanced": [
    { "label": "Axes", "type": "choice", "field": "whole", "options": [[true, "Combined"], [false, "X and Y apart"]], "def": true },
    { "label": "Angle snap", "unit": "deg", "field": "snap", "min": 0, "max": 45, "step": 1, "def": 0, "hmin": 0, "hmax": 45 },
    { "label": "Speed cap", "unit": "c/ms", "field": "speedCap", "min": 0, "max": 300, "step": 1, "def": 0, "hmin": 0, "hmax": 1000000, "hint": "0 = no cap" },
    { "label": "Left ×", "field": "lrRatio", "min": 0.1, "max": 3, "step": 0.01, "def": 1, "hmin": 0.001, "hmax": 1000 },
    { "label": "Up ×", "field": "udRatio", "min": 0.1, "max": 3, "step": 0.01, "def": 1, "hmin": 0.001, "hmax": 1000 },
    { "label": "Input smoothing", "unit": "ms", "field": "inputSmooth", "min": 0, "max": 100, "step": 1, "def": 0, "hmin": 0, "hmax": 10000 },
    { "label": "Scale smoothing", "unit": "ms", "field": "scaleSmooth", "min": 0, "max": 100, "step": 1, "def": 0, "hmin": 0, "hmax": 10000 },
    { "label": "Output smoothing", "unit": "ms", "field": "outputSmooth", "min": 0, "max": 100, "step": 1, "def": 0, "hmin": 0, "hmax": 10000 },
    { "label": "Lp norm", "field": "lpNorm", "min": 0.5, "max": 16, "step": 0.1, "def": 2, "hmin": 0.0001, "hmax": 16 },
    { "label": "Domain X", "field": "domainX", "min": 0.1, "max": 4, "step": 0.05, "def": 1, "hmin": 0.0001, "hmax": 1000 },
    { "label": "Domain Y", "field": "domainY", "min": 0.1, "max": 4, "step": 0.05, "def": 1, "hmin": 0.0001, "hmax": 1000 },
    { "label": "Range X", "field": "rangeX", "min": 0, "max": 4, "step": 0.05, "def": 1, "hmin": 0, "hmax": 1000 },
    { "label": "Range Y", "field": "rangeY", "min": 0, "max": 4, "step": 0.05, "def": 1, "hmin": 0, "hmax": 1000 }
  ]
}
